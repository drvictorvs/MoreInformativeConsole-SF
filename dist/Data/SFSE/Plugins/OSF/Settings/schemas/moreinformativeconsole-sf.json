{
  "schemaVersion": 1,
  "title": "More Informative Console",
  "description": "Information panel for the reference selected in the console. Changes apply the next time the console updates.",
  "groups": {
    "Panel": [
      { "key": "showPanel", "type": "bool", "label": "Show info panel", "default": true },
      { "key": "printToConsole", "type": "bool", "label": "Also print to console history", "default": false,
        "hint": "Prints the same information into the console each time you click a new reference." },
      { "key": "alignment", "type": "enum", "label": "Position", "default": "right",
        "options": { "right": "Right edge of the console", "left": "Left edge of the console" } },
      { "key": "margin", "type": "float", "label": "Margin", "default": 16.0, "min": 0.0, "max": 200.0, "step": 2.0,
        "hint": "Gap between the panel and the edges of the console and the screen." },
      { "key": "overConsole", "type": "bool", "label": "Cover the console", "default": false,
        "hint": "Lines the panel's bottom up with the console's bottom instead of placing it above the console." },
      { "key": "maxHeightPercent", "type": "float", "label": "Max height (% of screen)", "default": 100.0, "min": 20.0, "max": 100.0, "step": 5.0,
        "hint": "Longer text scrolls: mouse wheel over the panel, or PageUp/PageDown." },
      { "key": "scrollWithMouse", "type": "bool", "label": "Scroll with the mouse wheel", "default": false,
        "hint": "The console also uses the wheel to step through nearby references, and the panel then takes mouse input, so clicking on it doesn't select what's behind it." },
      { "key": "scrollKeys", "type": "bool", "label": "Scroll with PageUp/PageDown", "default": true },
      { "key": "scrollLines", "type": "int", "label": "Lines per scroll step", "default": 3, "min": 0, "max": 50,
        "hint": "0 scrolls a whole page." },
      { "key": "scrollRepeatFrames", "type": "int", "label": "Scroll repeat delay (frames)", "default": 10, "min": 1, "max": 120,
        "hint": "While a scroll key is held, another step every this many frames. Higher is slower." },
      { "key": "toggleKey", "type": "int", "label": "Show/hide key (key code)", "default": 9, "min": 0, "max": 254,
        "hint": "Windows virtual-key code: 9 = Tab, 0 = off. Shows or hides the panel while the console is open." },
      { "key": "padding", "type": "float", "label": "Inner margin", "default": 6.0, "min": 0.0, "max": 60.0, "step": 1.0,
        "hint": "Space between the panel's edge and its text." },
      { "key": "widthPercent", "type": "float", "label": "Width (% of console)", "default": 40.0, "min": 15.0, "max": 100.0, "step": 5.0 },
      { "key": "panelScale", "type": "float", "label": "Scale", "default": 1.0, "min": 0.5, "max": 2.5, "step": 0.05,
        "hint": "Scales the whole panel, text included." },
      { "key": "fontSize", "type": "int", "label": "Font size", "default": 0, "min": 0, "max": 48,
        "hint": "0 uses the console's own text size." },
      { "key": "backgroundOpacity", "type": "float", "label": "Background opacity", "default": 0.65, "min": 0.0, "max": 1.0, "step": 0.05 },
      { "key": "offsetX", "type": "int", "label": "Nudge horizontally (px)", "default": 0, "min": -2000, "max": 2000 },
      { "key": "offsetY", "type": "int", "label": "Nudge vertically (px)", "default": 0, "min": -2000, "max": 2000,
        "hint": "Negative moves the panel up." },
      { "key": "headerColor", "type": "string", "label": "Heading color", "default": "#F2C14E", "maxLength": 9 },
      { "key": "labelColor", "type": "string", "label": "Label color", "default": "#9FB4C8", "maxLength": 9 },
      { "key": "backgroundColor", "type": "string", "label": "Background color", "default": "#000000", "maxLength": 9 }
    ],
    "Selection highlight": [
      { "key": "highlightSelection", "type": "bool", "label": "Highlight the selected reference", "default": true,
        "hint": "Uses the game's own console selection highlight. A new color shows from the next reference you select. Off leaves the game's setting alone." },
      { "key": "highlightColor", "type": "string", "label": "Highlight color", "default": "#F2C14E", "maxLength": 9 },
      { "key": "highlightOpacity", "type": "float", "label": "Highlight opacity", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.05 }
    ],
    "Sections": [
      { "key": "showReference", "type": "bool", "label": "Reference", "default": true },
      { "key": "showBase", "type": "bool", "label": "Base object", "default": true },
      { "key": "showModel", "type": "bool", "label": "Model path", "default": true },
      { "key": "showKeywords", "type": "bool", "label": "Keywords", "default": true },
      { "key": "maxKeywords", "type": "int", "label": "Keywords shown", "default": 12, "min": 1, "max": 60 },
      { "key": "showNPC", "type": "bool", "label": "NPC (race, traits, level)", "default": true },
      { "key": "showFactions", "type": "bool", "label": "Factions and ranks", "default": true },
      { "key": "factionsAsList", "type": "bool", "label": "Factions as a list", "default": false,
        "hint": "One faction per line, like the worn items, instead of one comma-separated line." },
      { "key": "maxFactions", "type": "int", "label": "Factions shown", "default": 12, "min": 1, "max": 100 },
      { "key": "showAI", "type": "bool", "label": "AI and animation (package, idle, furniture, dialogue)", "default": true },
      { "key": "showAliases", "type": "bool", "label": "Quest aliases", "default": true },
      { "key": "maxAliases", "type": "int", "label": "Quest aliases shown", "default": 12, "min": 1, "max": 100 },
      { "key": "showWorn", "type": "bool", "label": "Worn items and biped slots", "default": true },
      { "key": "maxWornItems", "type": "int", "label": "Worn items shown", "default": 16, "min": 1, "max": 64 },
      { "key": "showWornModels", "type": "bool", "label": "Armor addon and model for each worn item", "default": true },
      { "key": "showLock", "type": "bool", "label": "Lock", "default": true },
      { "key": "showInventory", "type": "bool", "label": "Inventory", "default": true },
      { "key": "maxInventoryItems", "type": "int", "label": "Inventory items shown", "default": 8, "min": 1, "max": 60 },
      { "key": "showPosition", "type": "bool", "label": "Position, cell and location", "default": true },
      { "key": "showLocationChain", "type": "bool", "label": "Parent locations", "default": true }
    ],
    "Details": [
      { "key": "showMaterialSwaps", "type": "bool", "label": "Material swaps (base model and worn addons)", "default": false },
      { "key": "maxSwapEntries", "type": "int", "label": "Material swap entries shown per form", "default": 6, "min": 1, "max": 64 },
      { "key": "showActorState", "type": "bool", "label": "Actor state (combat, talking, scene)", "default": false },
      { "key": "showActorValues", "type": "bool", "label": "Actor values (health, oxygen, AI values)", "default": false },
      { "key": "actorValuesAsList", "type": "bool", "label": "Actor values as a list", "default": false,
        "hint": "One value per line. Each shows the current value, then (base N) when the base differs." },
      { "key": "avHealth", "type": "bool", "label": "  Health", "default": true },
      { "key": "avOxygen", "type": "bool", "label": "  Oxygen", "default": true },
      { "key": "avCarry", "type": "bool", "label": "  Carry weight", "default": true },
      { "key": "avSpeed", "type": "bool", "label": "  Speed", "default": true },
      { "key": "avAggression", "type": "bool", "label": "  Aggression", "default": true },
      { "key": "avConfidence", "type": "bool", "label": "  Confidence", "default": true },
      { "key": "avAssistance", "type": "bool", "label": "  Assistance", "default": true },
      { "key": "avMorality", "type": "bool", "label": "  Morality", "default": true },
      { "key": "avHideSpacesuit", "type": "bool", "label": "  Hide spacesuit (settlements)", "default": true },
      { "key": "avHideHelmet", "type": "bool", "label": "  Hide helmet (breathable air)", "default": true },
      { "key": "extraActorValues", "type": "string", "label": "  More actor values (editor IDs)", "default": "",
        "hint": "Comma-separated actor value editor IDs. Find them with: help <name> 4 avif" },
      { "key": "showMagicEffects", "type": "bool", "label": "Active magic effects", "default": false,
        "hint": "Effect, source spell or item, caster, magnitude and time left." },
      { "key": "maxMagicEffects", "type": "int", "label": "Magic effects shown", "default": 12, "min": 1, "max": 100 },
      { "key": "showGraphVariables", "type": "bool", "label": "Animation graph variables", "default": false },
      { "key": "graphVariables", "type": "string", "label": "Graph variables to read", "default": "iState, bIsSitting, Speed, Direction, bInJumpState", "maxLength": 512,
        "hint": "Comma-separated. bName = bool, iName = int, others float; or force with name:b, name:i, name:f." },
      { "key": "showBounds", "type": "bool", "label": "Object size", "default": false },
      { "key": "showGravity", "type": "bool", "label": "Gravity", "default": false },
      { "key": "showEngineDetails", "type": "bool", "label": "Engine debug text", "default": false }
    ],
    "Diagnostics": [
      { "key": "refreshFrames", "type": "int", "label": "Refresh every N frames", "default": 15, "min": 1, "max": 120 },
      { "key": "debugLog", "type": "bool", "label": "Debug log", "default": false,
        "hint": "Writes the selection text and panel layout to MoreInformativeConsoleSF.log." }
    ]
  }
}
